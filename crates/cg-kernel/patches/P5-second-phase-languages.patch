diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	2026-11-01 14:14:01.152495451 +0000
+++ b/Cargo.toml	2026-11-01 14:14:27.059335777 +0000
@@ -10,13 +10,22 @@
 crate-type = ["rlib"]
 
 [features]
-default = ["lang-ts", "lang-python", "lang-go", "lang-java", "lang-rust", "lang-kotlin"]
+default = [
+    "lang-ts", "lang-python", "lang-go", "lang-java", "lang-rust", "lang-kotlin",
+    "lang-c", "lang-csharp", "lang-php", "lang-ruby", "lang-swift",
+]
 lang-ts = ["dep:tree-sitter-typescript", "dep:tree-sitter-javascript"]
 lang-python = ["dep:tree-sitter-python"]
 lang-go = ["dep:tree-sitter-go"]
 lang-java = ["dep:tree-sitter-java"]
 lang-rust = ["dep:tree-sitter-rust"]
 lang-kotlin = ["dep:tree-sitter-language"]
+# P5: second-phase languages. `lang-c` covers C and C++ (one walker, two grammars).
+lang-c = ["dep:tree-sitter-c", "dep:tree-sitter-cpp"]
+lang-csharp = ["dep:tree-sitter-c-sharp"]
+lang-php = ["dep:tree-sitter-php"]
+lang-ruby = ["dep:tree-sitter-ruby"]
+lang-swift = ["dep:tree-sitter-language"]
 
 [dependencies]
 tree-sitter = "0.25"
@@ -31,7 +40,13 @@
 tree-sitter-python = { version = "0.23", optional = true }
 tree-sitter-go = { version = "0.23", optional = true }
 tree-sitter-rust = { version = "=0.24.2", optional = true }
-# Kotlin is vendored C (grammars/kotlin, compiled by build.rs): no usable crate exists.
+tree-sitter-c = { version = "=0.24.2", optional = true }
+tree-sitter-cpp = { version = "=0.23.4", optional = true }
+tree-sitter-c-sharp = { version = "=0.23.5", optional = true }
+tree-sitter-ruby = { version = "=0.23.1", optional = true }
+# php: the walker calls LANGUAGE_PHP (HTML-interleaving variant), never LANGUAGE_PHP_ONLY.
+tree-sitter-php = { version = "=0.24.2", optional = true }
+# Kotlin and Swift are vendored C (grammars/{kotlin,swift}, compiled by build.rs).
 tree-sitter-language = { version = "0.1", optional = true }
 
 [target.'cfg(unix)'.dependencies]
diff -ruN a/build.rs b/build.rs
--- a/build.rs	2026-11-01 14:14:01.152732478 +0000
+++ b/build.rs	2026-11-01 14:14:27.059607824 +0000
@@ -1,7 +1,6 @@
 fn main() {
-    // P1: napi_build::setup() removed. Only the Kotlin grammar (vendored C) is
-    // compiled here; the other vendored grammars (lua, scala, dart, swift)
-    // join with their walkers in M5.
+    // P1: napi_build::setup() removed. P5: the Kotlin and Swift grammars
+    // (vendored C) are compiled here; lua, scala and dart are not vendored.
     if std::env::var_os("CARGO_FEATURE_LANG_KOTLIN").is_some() {
         // Kotlin grammar — vendored C, compiled here instead of a crate dep: the
         // crates.io tree-sitter-kotlin 0.3.8 pins `tree-sitter >= 0.21, < 0.23`
@@ -26,5 +25,25 @@
         c.compile("tree-sitter-kotlin");
         println!("cargo:rerun-if-changed=grammars/kotlin");
     }
+    // P5: Swift grammar - vendored C, the crates.io tree-sitter-swift 0.7.3
+    // tarball's src/ with upstream's scanner fix (`1ULL << FAKE_TRY_BANG`: the
+    // crate's `1UL` overflows where `unsigned long` is 32 bits, i.e. MSVC, and
+    // `try! Foo()` would read as `!Foo`). Flags crib the tarball's own
+    // bindings/rust/build.rs (c11).
+    //   parser.c  d3edff6effe31b9a507f496577407987343b101b23eb7bee7a9b050e8ab5d27a
+    //   scanner.c 8acafef098ea4a52ebfc4cdf2fe26706113a22ac8ba2faf7d952755ff350cad6 (patched)
+    if std::env::var_os("CARGO_FEATURE_LANG_SWIFT").is_some() {
+        let mut swift = cc::Build::new();
+        swift.std("c11");
+        swift.include("grammars/swift");
+        swift.file("grammars/swift/parser.c");
+        swift.file("grammars/swift/scanner.c");
+        swift.flag_if_supported("-Wno-unused-parameter");
+        swift.flag_if_supported("-Wno-unused-but-set-variable");
+        swift.flag_if_supported("-Wno-trigraphs");
+        swift.flag_if_supported("-utf-8"); // msvc
+        swift.compile("tree-sitter-swift");
+        println!("cargo:rerun-if-changed=grammars/swift");
+    }
     println!("cargo:rerun-if-changed=build.rs");
 }
